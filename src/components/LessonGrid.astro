---
interface Lesson {
  slug: string;
  title: string;
  description?: string;
  image?: string;
  count?: number;
}
interface Props {
  lessons: Lesson[];
  limit?: number;
}
const { lessons, limit } = Astro.props;
const displayed = limit ? lessons.slice(0, limit) : lessons;
---

<div class="lesson-grid">
  {displayed.map((lesson) => (
    <a class="lesson-card" href={`/${lesson.slug}/`}>
      <img
        class="lesson-card-thumb"
        src={lesson.image || "/images/logo-270.jpeg"}
        alt={lesson.title}
        loading="lazy"
      />
      <div class="lesson-card-body">
        <h3>{lesson.title}</h3>
        {lesson.count && <p>{lesson.count} lesson{lesson.count !== 1 ? "s" : ""}</p>}
        {lesson.description && !lesson.count && <p>{lesson.description.slice(0, 80)}{lesson.description.length > 80 ? "…" : ""}</p>}
      </div>
      <div class="lesson-card-arrow">
        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </a>
  ))}
</div>
