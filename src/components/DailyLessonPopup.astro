---
/**
 * 35-second popup: daily Bitachon lesson email opt-in.
 */
import { site } from "../data/site";

const apiUrl = (
  import.meta.env.PUBLIC_CONTACT_API_URL ||
  "https://trusthashem-contact.thelavglow.workers.dev"
).replace(/\/$/, "");
---

<div id="daily-lesson-popup" class="daily-lesson-popup" hidden>
  <div class="daily-lesson-backdrop" data-daily-close></div>
  <div class="daily-lesson-card" role="dialog" aria-modal="true" aria-labelledby="daily-lesson-title">
    <button class="daily-lesson-x" type="button" aria-label="Close" data-daily-close>&times;</button>
    <p class="daily-lesson-eyebrow">Daily Bitachon · Chizuk</p>
    <h2 id="daily-lesson-title">Get your daily Bitachon chizuk here</h2>
    <p class="daily-lesson-copy">
      Subscribe with your email and receive daily chizuk — a fresh Bitachon lesson whenever a new podcast is posted.
    </p>
    <form id="daily-lesson-form" class="daily-lesson-form" novalidate>
      <label class="sr-only" for="daily-lesson-email">Email address</label>
      <input
        id="daily-lesson-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="400"
        placeholder="Enter your email to subscribe"
      />
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="daily-honeypot" aria-hidden="true" />
      <button class="btn btn-wine" type="submit">Subscribe for daily chizuk</button>
    </form>
    <p class="daily-lesson-msg" id="daily-lesson-msg" hidden></p>
    <p class="daily-lesson-note">Updates from {site.email} · reply anytime to unsubscribe.</p>
  </div>
</div>

<style>
  .daily-lesson-popup {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: grid;
    place-items: center;
    padding: 1.25rem;
  }
  .daily-lesson-popup[hidden] { display: none !important; }
  .daily-lesson-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(28, 18, 10, 0.55);
  }
  .daily-lesson-card {
    position: relative;
    z-index: 1;
    width: min(100%, 440px);
    background: linear-gradient(165deg, #fffaf2 0%, #f7f1e4 100%);
    border: 1px solid rgba(107, 36, 29, 0.18);
    border-radius: 22px;
    padding: 1.75rem 1.55rem 1.4rem;
    box-shadow: 0 28px 70px rgba(20, 12, 6, 0.35);
    animation: dailyLessonIn 0.4s ease both;
  }
  .daily-lesson-x {
    position: absolute;
    top: 0.55rem;
    right: 0.7rem;
    appearance: none;
    border: 0;
    background: transparent;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--ink-soft, #5c4c3a);
    cursor: pointer;
  }
  .daily-lesson-eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wine, #6b241d);
  }
  .daily-lesson-card h2 {
    margin: 0 0 0.7rem;
    font-size: clamp(1.55rem, 4vw, 2rem);
    line-height: 1.15;
    color: var(--ink, #1a1510);
  }
  .daily-lesson-copy {
    margin: 0 0 1.2rem;
    color: var(--ink-soft, #5c4c3a);
    font-size: 1.02rem;
    line-height: 1.55;
  }
  .daily-lesson-form {
    display: grid;
    gap: 0.75rem;
  }
  .daily-lesson-form input[type="email"] {
    width: 100%;
    border: 1px solid rgba(90, 58, 28, 0.25);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    font: inherit;
    font-size: 1rem;
    background: #fff;
  }
  .daily-lesson-form .btn {
    width: 100%;
    justify-content: center;
    padding-block: 0.95rem;
    font-size: 1rem;
  }
  .daily-honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }
  .daily-lesson-msg {
    margin: 0.8rem 0 0;
    font-size: 0.95rem;
  }
  .daily-lesson-msg.is-ok { color: #1b5e3b; }
  .daily-lesson-msg.is-error { color: #8a1f12; }
  .daily-lesson-note {
    margin: 0.9rem 0 0;
    font-size: 0.78rem;
    color: var(--ink-soft, #5c4c3a);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
  @keyframes dailyLessonIn {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
</style>

<script define:vars={{ apiUrl, siteEmail: site.email }}>
  const STORAGE_KEY = "th-daily-bitachon-optin-v3";
  const DELAY_MS = 35000;
  const popup = document.getElementById("daily-lesson-popup");
  const form = document.getElementById("daily-lesson-form");
  const msg = document.getElementById("daily-lesson-msg");
  const emailInput = document.getElementById("daily-lesson-email");

  function alreadyHandled() {
    try {
      return localStorage.getItem(STORAGE_KEY) === "1";
    } catch {
      return false;
    }
  }

  function markHandled() {
    try {
      localStorage.setItem(STORAGE_KEY, "1");
    } catch {}
  }

  function setMsg(text, kind = "") {
    if (!msg) return;
    msg.hidden = !text;
    msg.textContent = text || "";
    msg.classList.toggle("is-ok", kind === "ok");
    msg.classList.toggle("is-error", kind === "error");
  }

  function closePopup() {
    if (!popup) return;
    popup.hidden = true;
    popup.setAttribute("hidden", "");
  }

  function openPopup() {
    if (!popup || alreadyHandled()) return;
    popup.hidden = false;
    popup.removeAttribute("hidden");
    window.setTimeout(() => emailInput?.focus(), 200);
  }

  if (!alreadyHandled()) {
    window.setTimeout(openPopup, DELAY_MS);
  }

  popup?.querySelectorAll("[data-daily-close]").forEach((el) => {
    el.addEventListener("click", () => {
      markHandled();
      closePopup();
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && popup && !popup.hidden) {
      markHandled();
      closePopup();
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = String(emailInput?.value || "").trim().toLowerCase();
    const honeypot = String(form.querySelector('[name="website"]')?.value || "");
    if (honeypot) {
      markHandled();
      closePopup();
      return;
    }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setMsg("Please enter a valid email address.", "error");
      return;
    }
    const submitBtn = form.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.setAttribute("disabled", "true");
      submitBtn.textContent = "Subscribing…";
    }
    setMsg("");
    try {
      const res = await fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          intent: "daily-lesson-subscribe",
          email,
          source: "daily-popup-35s",
          website: "",
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || "Could not subscribe.");
      markHandled();
      setMsg(
        data.already
          ? `You are already subscribed. Updates come from ${siteEmail}.`
          : `You are in. Your daily Bitachon lessons will come from ${siteEmail}.`,
        "ok",
      );
      window.setTimeout(closePopup, 2200);
    } catch (err) {
      setMsg(err?.message || "Could not subscribe. Please try again.", "error");
      if (submitBtn) {
        submitBtn.removeAttribute("disabled");
        submitBtn.textContent = "Subscribe for daily chizuk";
      }
    }
  });
</script>
