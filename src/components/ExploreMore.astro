---
/** Small Joey-style "Explore More →" text link */
interface Props {
  href: string;
  label?: string;
  align?: "start" | "center" | "end";
}
const { href, label = "Explore More", align = "start" } = Astro.props;
---

<a class={`explore-more explore-more--${align}`} href={href}>
  <span>{label}</span>
  <span class="explore-more-arrow" aria-hidden="true">→</span>
</a>

<style>
  .explore-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.5rem;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: #3a6ea5;
    transition: color .18s, gap .18s;
  }
  .explore-more--center { display: flex; width: fit-content; margin-inline: auto; }
  .explore-more--end { margin-left: auto; }
  .explore-more-arrow {
    font-weight: 500;
    transition: transform .18s;
  }
  .explore-more:hover {
    color: var(--wine);
    gap: 0.5rem;
  }
  .explore-more:hover .explore-more-arrow {
    transform: translateX(2px);
  }
</style>
