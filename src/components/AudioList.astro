---
interface Track {
  title: string;
  description?: string;
  src: string;
}
interface Props {
  tracks: Track[];
}
const { tracks } = Astro.props;
---

<div class="track-list">
  {tracks.map((track) => (
    <div class="track-item">
      <h3>{track.title}</h3>
      {track.description && <p>{track.description}</p>}
      <audio controls preload="none">
        <source src={track.src} />
        Your browser does not support the audio element.
      </audio>
    </div>
  ))}
</div>
