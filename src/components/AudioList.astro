---
import { mediaUrl } from "../data/site";

interface Track {
  title: string;
  subtitle?: string;
  description?: string;
  audio?: string;
  src?: string;
}
interface Props {
  tracks: Track[];
}
const { tracks } = Astro.props;

const playable = tracks.filter((track) => track.audio || track.src);
---

{playable.length > 0 ? (
  <div class="track-list">
    {playable.map((track) => {
      const src = mediaUrl(track.audio || track.src || "");
      return (
        <div class="track-item">
          <h3>{track.title}</h3>
          {(track.subtitle || track.description) && (
            <p>{track.subtitle || track.description}</p>
          )}
          <audio controls preload="metadata">
            <source src={src} type="audio/ogg" />
            <source src={src.replace(/\.ogg$/i, ".mp3")} type="audio/mpeg" />
            Your browser does not support the audio element.
          </audio>
        </div>
      );
    })}
  </div>
) : (
  <p class="empty-note">Audio for this series is being prepared. Please check back soon or email bitachon@trusthashem.org.</p>
)}
