---
import { site } from "../data/site";
---

<div class="donate-box">
  <span class="eyebrow">PayPal</span>
  <h2>Give securely</h2>
  <p>Use the same PayPal donation that has always been on TrustHashem.org. Any amount helps keep the shiurim free.</p>
  <form action="https://www.paypal.com/donate" method="post" target="_blank">
    <input type="hidden" name="hosted_button_id" value={site.paypalButtonId} />
    <button class="btn btn-gold" type="submit">Donate with PayPal</button>
  </form>
</div>
