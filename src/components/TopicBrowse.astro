---
interface Topic {
  title: string;
  blurb: string;
  href: string;
  image?: string;
}
interface Props {
  topics: Topic[];
}
const { topics } = Astro.props;
---

<div class="topic-grid">
  {topics.map((topic) => (
    <a class="topic-card" href={topic.href}>
      {topic.image && (
        <div class="topic-card-media">
          <img src={topic.image} alt="" loading="lazy" />
        </div>
      )}
      <div class="topic-card-body">
        <h3>{topic.title}</h3>
        <p>{topic.blurb}</p>
        <span>Explore →</span>
      </div>
    </a>
  ))}
</div>

<style>
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .topic-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    min-height: 100%;
    transition: border-color .2s, transform .2s;
  }
  .topic-card:hover {
    border-color: var(--border-gold);
    transform: translateY(-2px);
  }
  .topic-card-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #ede4d3;
  }
  .topic-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .topic-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1.15rem 1.15rem;
    flex: 1;
  }
  .topic-card h3 {
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.25;
  }
  .topic-card p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-muted);
    flex: 1;
  }
  .topic-card span {
    margin-top: 0.55rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: none;
    color: #3a6ea5;
  }
  @media (max-width: 600px) {
    .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
    .topic-card-body { padding: 0.85rem 0.85rem 0.95rem; }
    .topic-card h3 { font-size: 1rem; }
    .topic-card p { font-size: 0.8rem; }
  }
</style>
