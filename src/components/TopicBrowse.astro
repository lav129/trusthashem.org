---
interface Topic {
  title: string;
  href: string;
  image?: string;
}
interface Props {
  topics: Topic[];
}
const { topics } = Astro.props;
---

<div class="topic-grid">
  {topics.map((topic) => (
    <a class="topic-card" href={topic.href} aria-label={topic.title}>
      <img
        class="topic-card-img"
        src={topic.image || "/images/photo-books.jpg"}
        alt=""
        loading="lazy"
      />
      <span class="topic-card-shade" aria-hidden="true"></span>
      <h3 class="topic-card-name">{topic.title}</h3>
    </a>
  ))}
</div>

<style>
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }
  .topic-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--border);
    text-decoration: none;
    color: #fff;
    background: #1a140e;
    min-width: 0;
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }
  .topic-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-gold);
    box-shadow: var(--shadow-md);
  }
  .topic-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform .45s ease;
  }
  .topic-card:hover .topic-card-img {
    transform: scale(1.04);
  }
  .topic-card-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 12, 6, 0.12) 0%, rgba(20, 12, 6, 0.28) 42%, rgba(20, 12, 6, 0.82) 100%);
    z-index: 1;
  }
  .topic-card-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    margin: 0;
    padding: 1.15rem 1rem 1.2rem;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }
  @media (max-width: 600px) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .topic-card-name {
      font-size: 1.05rem;
      padding: 0.9rem 0.75rem 1rem;
    }
  }
</style>
