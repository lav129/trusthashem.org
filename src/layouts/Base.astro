---
import "../styles/global.css";
import { moreNav, nav, site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Teachings of Bitachon and Emunah with Rebbetzin Leah Donner in Geula, Jerusalem.",
  image = "/images/hero.webp",
} = Astro.props;

const pageTitle = title.includes("Trust Hashem") ? title : `${title} · Trust Hashem`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/logo-192.jpeg" />
    <link rel="apple-touch-icon" href="/images/logo-270.jpeg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <!-- Brand -->
        <a class="brand" href="/">
          <img class="brand-logo" src="/images/logo-270.jpeg" alt="Trust Hashem" />
          <div class="brand-text">
            <span class="brand-name">Trust Hashem</span>
            <span class="brand-tagline">Emunah & Bitachon</span>
          </div>
        </a>

        <!-- Hamburger -->
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>

        <!-- Nav -->
        <nav id="main-nav" class="main-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
              class={item.label === "Donate" ? "nav-cta" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <!-- Brand col -->
          <div class="footer-brand">
            <a class="brand" href="/" style="margin-bottom:1rem;display:inline-flex">
              <img class="brand-logo" src="/images/logo-270.jpeg" alt="Trust Hashem" />
              <div class="brand-text">
                <span class="brand-name">Trust Hashem</span>
                <span class="brand-tagline bsd">בס״ד</span>
              </div>
            </a>
            <p>Teachings of Bitachon and Emunah presented by Rebbetzin Leah Donner from Geula, Jerusalem. Rooted in the wisdom of Shaar Habitachon, the Beis HaLevi, and the sages.</p>
          </div>

          <!-- Learn -->
          <div class="footer-col">
            <h4>Learn</h4>
            {moreNav.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>

          <!-- Site -->
          <div class="footer-col">
            <h4>Site</h4>
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>

          <!-- Connect -->
          <div class="footer-col">
            <h4>Connect</h4>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <a href={site.homeWhatsapp} rel="noopener noreferrer" target="_blank">WhatsApp Group</a>
            <a href="/donate/">Support This Work</a>
            <a href="https://www.youtube.com/@TrustHashem" rel="noopener noreferrer" target="_blank">YouTube Channel</a>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Trust Hashem · {site.place}</span>
          <a href={site.webDream} rel="noopener noreferrer" target="_blank">Built with care by Web Dream</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.querySelector(".menu-btn");
      const nav = document.querySelector("#main-nav");
      btn?.addEventListener("click", () => {
        const open = nav?.classList.toggle("open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });
      // close on outside click
      document.addEventListener("click", (e) => {
        if (!btn?.contains(e.target as Node) && !nav?.contains(e.target as Node)) {
          nav?.classList.remove("open");
          btn?.setAttribute("aria-expanded", "false");
        }
      });
    </script>
  </body>
</html>
