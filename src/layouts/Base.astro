---
import "../styles/global.css";
import { moreNav, nav, site, social } from "../data/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Teachings of Bitachon and Emunah with Rebbetzin Leah Donner in Geula, Jerusalem.",
  image = "/images/share-tree.png",
} = Astro.props;

const pageTitle = title.includes("Trust Hashem") ? title : `${title} · Trust Hashem`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const shareImage = new URL(image, site.url).href;
const logoImage = new URL("/images/logo-512.png", site.url).href;
const treeImage = new URL("/images/share-tree.png", site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      if (location.protocol === "http:" && location.hostname !== "localhost" && location.hostname !== "127.0.0.1") {
        location.replace("https://" + location.host + location.pathname + location.search + location.hash);
      }
    </script>
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Trust Hashem tree" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content="Trust Hashem tree" />
    <link rel="image_src" href={shareImage} />
    <meta name="theme-color" content="#6b241d" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Trust Hashem",
      url: site.url,
      logo: logoImage,
      image: treeImage,
    })} />
  </head>
  <body>
    <div id="welcome-splash" class="welcome-splash" hidden>
      <div class="welcome-splash-card">
        <div class="welcome-tree-wrap">
          <img src="/images/welcome-tree.png?v=20260908t" alt="Trust Hashem tree" width="360" height="360" />
          <div class="welcome-lights" aria-hidden="true">
            {Array.from({ length: 28 }, (_, i) => (
              <span class="welcome-light" style={`--i:${i}`}></span>
            ))}
          </div>
        </div>
        <div class="welcome-leaves" aria-hidden="true">
          {Array.from({ length: 22 }, (_, i) => (
            <span class="welcome-leaf" style={`--i:${i}`}></span>
          ))}
        </div>
        <p>Welcome to Trust Hashem</p>
      </div>
    </div>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <!-- Brand -->
        <a class="brand" href="/">
          <img class="brand-logo" src="/images/logo-270.jpeg" alt="Trust Hashem" />
          <div class="brand-text">
            <span class="brand-name">Trust Hashem</span>
            <span class="brand-tagline">Emunah & Bitachon</span>
          </div>
        </a>

        <!-- Hamburger -->
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>

        <!-- Nav -->
        <nav id="main-nav" class="main-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
              class={item.label === "Donate" ? "nav-cta" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <!-- Brand col -->
          <div class="footer-brand">
            <a class="brand" href="/" style="margin-bottom:1rem;display:inline-flex">
              <img class="brand-logo" src="/images/logo-270.jpeg" alt="Trust Hashem" />
              <div class="brand-text">
                <span class="brand-name">Trust Hashem</span>
                <span class="brand-tagline bsd">בס״ד</span>
              </div>
            </a>
            <p>Teachings of Bitachon and Emunah presented by Rebbetzin Leah Donner from Geula, Jerusalem. Rooted in the wisdom of Shaar Habitachon, the Beis HaLevi, and the sages.</p>
          </div>

          <!-- Learn -->
          <div class="footer-col">
            <h4>Learn</h4>
            {moreNav.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>

          <!-- Site -->
          <div class="footer-col">
            <h4>Site</h4>
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>

          <!-- Connect -->
          <div class="footer-col">
            <h4>Connect</h4>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <a href="/mentorship/">Mentorship</a>
            <a href={social.leahDonnerSite}>LeahDonnerOfficial.com</a>
            <a href={site.homeWhatsapp} rel="noopener noreferrer" target="_blank">WhatsApp Group</a>
            <a href="/donate/">Support This Work</a>
            <a href={social.youtube} rel="noopener noreferrer" target="_blank">YouTube Channel</a>
            <a href={social.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>
            <a href="/podcasts/">Podcasts</a>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Trust Hashem · {site.place}</span>
          <a href={site.webDream} rel="noopener noreferrer" target="_blank">Built with care by Web Dream</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.querySelector(".menu-btn");
      const nav = document.querySelector("#main-nav");
      btn?.addEventListener("click", () => {
        const open = nav?.classList.toggle("open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });
      document.addEventListener("click", (e) => {
        if (!btn?.contains(e.target as Node) && !nav?.contains(e.target as Node)) {
          nav?.classList.remove("open");
          btn?.setAttribute("aria-expanded", "false");
        }
      });

      const splash = document.getElementById("welcome-splash");
      if (splash) {
        let seen = false;
        try {
          seen = sessionStorage.getItem("th-welcome-v5") === "1";
        } catch {
          seen = false;
        }
        if (seen) {
          splash.remove();
        } else {
          try {
            sessionStorage.setItem("th-welcome-v5", "1");
          } catch {}
          splash.hidden = false;
          let closed = false;
          const closeSplash = () => {
            if (closed) return;
            closed = true;
            splash.classList.add("is-leaving");
            window.setTimeout(() => splash.remove(), 450);
          };
          const timer = window.setTimeout(closeSplash, 5000);
          splash.addEventListener("pointerdown", () => {
            window.clearTimeout(timer);
            closeSplash();
          }, { once: true });
        }
      }

      document.addEventListener("click", async (e) => {
        const link = (e.target as HTMLElement | null)?.closest?.("a.js-audio-download") as HTMLAnchorElement | null;
        if (!link) return;
        e.preventDefault();
        const url = link.href;
        const fileName = link.dataset.filename || decodeURIComponent(url.split("/").pop()?.split("?")[0] || "lesson.ogg");
        const prev = link.textContent;
        link.setAttribute("aria-busy", "true");
        link.textContent = "Saving…";
        try {
          const res = await fetch(url, { mode: "cors", credentials: "omit" });
          if (!res.ok) throw new Error(String(res.status));
          const blob = await res.blob();
          const objectUrl = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = objectUrl;
          a.download = fileName;
          a.rel = "noopener";
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(objectUrl);
        } catch {
          // Fallback: open the existing source URL (no copied storage). Browser may still save via Content-Disposition.
          const a = document.createElement("a");
          a.href = url;
          a.download = fileName;
          a.target = "_blank";
          a.rel = "noopener";
          document.body.appendChild(a);
          a.click();
          a.remove();
        } finally {
          link.textContent = prev || "Download";
          link.removeAttribute("aria-busy");
        }
      });
    </script>
  </body>
</html>
