---
import Base from "../../layouts/Base.astro";
import { podcasts, fetchPodcastEpisodes } from "../../data/podcasts";

const shows = await Promise.all(
  podcasts.map(async (show) => ({
    ...show,
    episodes: await fetchPodcastEpisodes(show.showId, 5),
  })),
);
---

<Base
  title="Podcasts"
  description="Listen to Trust Hashem podcasts directly on this site — Bitachon, Emunah, festivals, classic sefarim, and women's learning groups."
  image="/images/photo-books.jpg"
>
  <section class="page-hero podcasts-hero">
    <div class="podcasts-hero-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="eyebrow">Listen anywhere</div>
      <h1>Podcasts</h1>
      <p class="lede">
        Shiurim you can take with you — festivals, classic mussar, Bitachon, Tehillim, and women's learning groups. Play every show right here.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="podcast-toolbar">
        <label class="sr-only" for="podcast-search">Search podcasts</label>
        <input
          id="podcast-search"
          class="podcast-search"
          type="search"
          placeholder="Search by title or topic…"
          autocomplete="off"
        />
        <div class="podcast-filters" role="group" aria-label="Filter podcasts">
          <button type="button" class="filter-chip is-active" data-filter="all">All</button>
          <button type="button" class="filter-chip" data-filter="Women's Group">Women's Group</button>
          <button type="button" class="filter-chip" data-filter="Classic">Classic</button>
          <button type="button" class="filter-chip" data-filter="Faith">Faith</button>
          <button type="button" class="filter-chip" data-filter="Festivals">Festivals</button>
        </div>
      </div>

      <p class="podcast-count" id="podcast-count" aria-live="polite">{shows.length} shows</p>

      <div class="podcast-grid" id="podcast-grid">
        {shows.map((show) => (
          <article
            class="podcast-card"
            id={show.slug}
            data-title={show.title.toLowerCase()}
            data-blurb={show.blurb.toLowerCase()}
            data-tag={show.tag || ""}
          >
            <div class="podcast-card-media">
              <img src={show.image || "/images/photo-books.jpg"} alt="" loading="lazy" />
            </div>
            <div class="podcast-card-body">
              {show.tag && <span class="card-tag">{show.tag}</span>}
              <h2>{show.title}</h2>
              <p>{show.blurb}</p>

              {show.episodes.length > 0 ? (
                <div class="podcast-episodes">
                  {show.episodes.map((ep) => (
                    <div class="podcast-ep">
                      <div class="podcast-ep-head">
                        <h3>{ep.title}</h3>
                        <a
                          class="js-audio-download"
                          href={ep.src}
                          download
                          data-filename={`${ep.title.replace(/[^\w\s-]+/g, "").trim().replace(/\s+/g, "-") || "episode"}.mp3`}
                          rel="noopener"
                        >Download</a>
                      </div>
                      <audio controls preload="none">
                        <source src={ep.src} type="audio/mpeg" />
                      </audio>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="podcast-fallback">Episodes are loading shortly. You can also open the full show externally.</p>
              )}

              <a class="podcast-cta" href={show.href} target="_blank" rel="noopener noreferrer">
                Full show on JewishPodcasts →
              </a>
            </div>
          </article>
        ))}
      </div>

      <p class="podcast-empty" id="podcast-empty" hidden>No podcasts match your search.</p>
    </div>
  </section>
</Base>

<style>
  .podcasts-hero {
    position: relative;
    overflow: hidden;
    border-bottom: none;
    padding-bottom: 3.5rem;
  }
  .podcasts-hero-bg {
    position: absolute;
    inset: 0;
    background: url("/images/photo-books.jpg") center / cover no-repeat;
    animation: panBg 28s ease-in-out infinite alternate;
    z-index: 0;
  }
  .podcasts-hero .eyebrow,
  .podcasts-hero h1,
  .podcasts-hero .lede {
    color: #fff;
    text-shadow: 0 2px 16px rgba(0,0,0,.5);
  }
  .podcasts-hero .lede { color: rgba(255,255,255,.92); }
  .podcasts-hero .wrap { position: relative; z-index: 1; }

  .podcast-toolbar {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .podcast-search {
    width: 100%;
    max-width: 420px;
    padding: 0.9rem 1.15rem;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    font: inherit;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .podcast-search:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,145,47,0.15);
  }
  .podcast-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-chip {
    border: 1px solid var(--border);
    background: var(--paper);
    color: var(--ink-soft);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .18s, border-color .18s, color .18s;
  }
  .filter-chip:hover { border-color: var(--border-gold); }
  .filter-chip.is-active {
    background: var(--wine);
    border-color: var(--wine);
    color: #fff;
  }
  .podcast-count {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: 1.5rem;
  }
  .podcast-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.35rem;
  }
  .podcast-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
    color: inherit;
    box-shadow: var(--shadow-sm);
    min-width: 0;
    scroll-margin-top: 6rem;
  }
  .podcast-card-media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #ede4d3;
  }
  .podcast-card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .podcast-card-body {
    padding: 1.2rem 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }
  .podcast-card-body h2 {
    font-size: 1.12rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .podcast-card-body > p {
    font-size: 0.9rem;
    color: var(--ink-muted);
    margin: 0;
  }
  .podcast-episodes {
    display: grid;
    gap: 0.85rem;
    margin-top: 0.55rem;
  }
  .podcast-ep {
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--border);
  }
  .podcast-ep-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }
  .podcast-ep h3 {
    font-family: var(--sans, inherit);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
    color: var(--ink);
  }
  .podcast-ep audio { width: 100%; }
  .podcast-ep .js-audio-download {
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold-deep);
    text-decoration: none;
  }
  .podcast-fallback {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin: 0.5rem 0 0;
  }
  .podcast-cta {
    margin-top: auto;
    padding-top: 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #3a6ea5;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .podcast-cta:hover { color: var(--wine); }
  .podcast-empty {
    text-align: center;
    color: var(--ink-muted);
    padding: 2rem 0;
  }
  @keyframes panBg {
    from { background-position: 30% center; }
    to { background-position: 70% center; }
  }
  @media (max-width: 600px) {
    .podcast-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const search = document.getElementById("podcast-search") as HTMLInputElement | null;
  const chips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
  const cards = document.querySelectorAll<HTMLElement>(".podcast-card");
  const count = document.getElementById("podcast-count");
  const empty = document.getElementById("podcast-empty");
  let activeTag = "all";

  function applyFilters() {
    const q = (search?.value || "").trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const title = card.dataset.title || "";
      const blurb = card.dataset.blurb || "";
      const tag = card.dataset.tag || "";
      const matchesText = !q || title.includes(q) || blurb.includes(q) || tag.toLowerCase().includes(q);
      const matchesTag = activeTag === "all" || tag === activeTag;
      const show = matchesText && matchesTag;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = `${visible} show${visible === 1 ? "" : "s"}`;
    if (empty) empty.hidden = visible !== 0;
  }

  search?.addEventListener("input", applyFilters);
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("is-active"));
      chip.classList.add("is-active");
      activeTag = chip.dataset.filter || "all";
      applyFilters();
    });
  });

  if (location.hash) {
    const el = document.querySelector(location.hash);
    el?.scrollIntoView({ behavior: "smooth", block: "start" });
  }
</script>
