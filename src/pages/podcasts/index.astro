---
import Base from "../../layouts/Base.astro";
import { podcasts } from "../../data/podcasts";
---

<Base
  title="Podcasts"
  description="Explore Trust Hashem podcasts on JewishPodcasts.fm — Bitachon, Emunah, festivals, classic sefarim, and women's learning groups."
  image="/images/photo-books.jpg"
>
  <section class="page-hero podcasts-hero">
    <div class="podcasts-hero-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="eyebrow">Listen anywhere</div>
      <h1>Podcasts</h1>
      <p class="lede">
        Shiurim you can take with you — festivals, classic mussar, Bitachon, Tehillim, and women's learning groups, all on JewishPodcasts.fm.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="podcast-toolbar">
        <label class="sr-only" for="podcast-search">Search podcasts</label>
        <input
          id="podcast-search"
          class="podcast-search"
          type="search"
          placeholder="Search by title or topic…"
          autocomplete="off"
        />
        <div class="podcast-filters" role="group" aria-label="Filter podcasts">
          <button type="button" class="filter-chip is-active" data-filter="all">All</button>
          <button type="button" class="filter-chip" data-filter="Women's Group">Women's Group</button>
          <button type="button" class="filter-chip" data-filter="Classic">Classic</button>
          <button type="button" class="filter-chip" data-filter="Faith">Faith</button>
          <button type="button" class="filter-chip" data-filter="Festivals">Festivals</button>
        </div>
      </div>

      <p class="podcast-count" id="podcast-count" aria-live="polite">{podcasts.length} shows</p>

      <div class="podcast-grid" id="podcast-grid">
        {podcasts.map((show) => (
          <a
            class="podcast-card"
            href={show.href}
            target="_blank"
            rel="noopener noreferrer"
            data-title={show.title.toLowerCase()}
            data-blurb={show.blurb.toLowerCase()}
            data-tag={show.tag || ""}
          >
            <div class="podcast-card-media">
              <img src={show.image || "/images/photo-books.jpg"} alt="" loading="lazy" />
              <span class="podcast-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </div>
            <div class="podcast-card-body">
              {show.tag && <span class="card-tag">{show.tag}</span>}
              <h2>{show.title}</h2>
              <p>{show.blurb}</p>
              <span class="podcast-cta">Listen on JewishPodcasts →</span>
            </div>
          </a>
        ))}
      </div>

      <p class="podcast-empty" id="podcast-empty" hidden>No podcasts match your search.</p>
    </div>
  </section>
</Base>

<style>
  .podcasts-hero {
    position: relative;
    overflow: hidden;
    border-bottom: none;
    padding-bottom: 3.5rem;
  }
  .podcasts-hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(253,248,240,.94) 35%, rgba(253,248,240,.55) 70%, rgba(253,248,240,.2)),
      url("/images/photo-books.jpg") center / cover no-repeat;
    animation: panBg 28s ease-in-out infinite alternate;
    z-index: 0;
  }
  .podcasts-hero .wrap { position: relative; z-index: 1; }

  .podcast-toolbar {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .podcast-search {
    width: 100%;
    max-width: 420px;
    padding: 0.9rem 1.15rem;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    font: inherit;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .podcast-search:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,145,47,0.15);
  }
  .podcast-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-chip {
    border: 1px solid var(--border);
    background: var(--paper);
    color: var(--ink-soft);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .18s, border-color .18s, color .18s;
  }
  .filter-chip:hover { border-color: var(--border-gold); }
  .filter-chip.is-active {
    background: var(--wine);
    border-color: var(--wine);
    color: #fff;
  }
  .podcast-count {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: 1.5rem;
  }
  .podcast-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.35rem;
  }
  .podcast-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform .25s, box-shadow .25s, border-color .25s;
    min-width: 0;
  }
  .podcast-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-gold);
  }
  .podcast-card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #ede4d3;
  }
  .podcast-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .podcast-card:hover .podcast-card-media img { transform: scale(1.05); }
  .podcast-play {
    position: absolute;
    inset: auto 1rem 1rem auto;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(114,42,34,0.92);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-md);
  }
  .podcast-card-body {
    padding: 1.2rem 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }
  .podcast-card-body h2 {
    font-size: 1.12rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .podcast-card-body p {
    font-size: 0.9rem;
    color: var(--ink-muted);
    margin: 0;
  }
  .podcast-cta {
    margin-top: auto;
    padding-top: 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--gold-deep);
    letter-spacing: 0.02em;
  }
  .podcast-empty {
    text-align: center;
    color: var(--ink-muted);
    padding: 2rem 0;
  }
  @keyframes panBg {
    from { background-position: 30% center; }
    to { background-position: 70% center; }
  }
  @media (max-width: 600px) {
    .podcast-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const search = document.getElementById("podcast-search") as HTMLInputElement | null;
  const chips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
  const cards = document.querySelectorAll<HTMLAnchorElement>(".podcast-card");
  const count = document.getElementById("podcast-count");
  const empty = document.getElementById("podcast-empty");
  let activeTag = "all";

  function applyFilters() {
    const q = (search?.value || "").trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const title = card.dataset.title || "";
      const blurb = card.dataset.blurb || "";
      const tag = card.dataset.tag || "";
      const matchesText = !q || title.includes(q) || blurb.includes(q) || tag.toLowerCase().includes(q);
      const matchesTag = activeTag === "all" || tag === activeTag;
      const show = matchesText && matchesTag;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = `${visible} show${visible === 1 ? "" : "s"}`;
    if (empty) empty.hidden = visible !== 0;
  }

  search?.addEventListener("input", applyFilters);
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("is-active"));
      chip.classList.add("is-active");
      activeTag = chip.dataset.filter || "all";
      applyFilters();
    });
  });
</script>
