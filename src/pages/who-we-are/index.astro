---
import { site } from "../../data/site";
import Base from "../../layouts/Base.astro";
import TeacherBio from "../../components/TeacherBio.astro";
---

<Base title="Who We Are" description="Rebbetzin Leah Donner teaches Bitachon and Emunah from Geula, Yerushalayim, with a free library of shiurim for Klal Yisrael.">
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">About</div>
      <h1>Who We Are</h1>
      <p class="lede">Trust Hashem is a Torah teaching home for Emunah and Bitachon, presented by Rebbetzin Leah Donner from Geula, Yerushalayim.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="bio-block">
          <img class="bio-img" src="/images/leah-donner-portrait.jpg?v=20260904c" alt="Rebbetzin Leah Donner" />
        <div class="bio-text">
          <span class="eyebrow" style="color:var(--gold);letter-spacing:.14em;text-transform:uppercase;font-size:.75rem;font-weight:600;display:block;margin-bottom:.6rem">The teacher</span>
          <h2>Rebbetzin Leah Donner</h2>
          <div class="divider" style="margin-bottom:1.5rem"></div>
          <TeacherBio />
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-header">
        <span class="eyebrow">From Geula</span>
        <h2>A home for Bitachon</h2>
        <div class="divider"></div>
        <p class="lead">The work is simple and serious: record the shiurim, keep them free, and help people live with trust in Hashem.</p>
      </div>
      <div class="card-grid">
        <article class="card">
          <img class="card-thumb" src="/images/photo-sky.jpg" alt="Open sky over the mountains" />
          <div class="card-body">
            <div class="card-tag">Place</div>
            <h3>Geula, Yerushalayim</h3>
            <p>The teachings come from the heart of Jerusalem, offered to students near and far through audio, WhatsApp groups, and this library.</p>
          </div>
        </article>
        <article class="card">
          <img class="card-thumb" src="/images/photo-books.jpg" alt="Sacred books" />
          <div class="card-body">
            <div class="card-tag">Sources</div>
            <h3>Classic sefarim</h3>
            <p>Shaar HaBitachon, Chovos HaLevavos, Beis HaLevi, Bilvavi, RaMCHaL, Pele Yoetz, Tomer Devorah, and related works of Emunah.</p>
          </div>
        </article>
        <article class="card">
          <img class="card-thumb" src="/images/photo-light.jpg" alt="Warm light" />
          <div class="card-body">
            <div class="card-tag">Purpose</div>
            <h3>Free for Klal Yisrael</h3>
            <p>More than a thousand recorded lessons stay online so anyone can learn, review, and share without a paywall.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-header">
        <span class="eyebrow">Also explore</span>
        <h2>Podcasts, Sessions & Support</h2>
        <div class="divider"></div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:2rem">
        <a class="btn btn-gold" href="/library/">Explore</a>
        <a class="btn btn-wine" href="/mentorship/">Schedule Group/Private Sessions</a>
        <a class="btn btn-gold" href="/donate/">Donate</a>
        <a class="btn btn-wine" href="/podcasts/">Browse Podcasts</a>
      </div>
      <div class="attributes-grid">
        <div class="attr-item"><p>A complete audio library of Emunah and Bitachon shiurim, kept at the original lesson addresses.</p></div>
        <div class="attr-item"><p>WhatsApp groups for daily connection, so the learning does not stay only on a website.</p></div>
        <div class="attr-item"><p>A public YouTube channel for anyone who prefers to watch, at <a href={site.youtube} rel="noopener noreferrer" target="_blank">@rebbetzinleahdonner</a>.</p></div>
        <div class="attr-item"><p>Private and group sessions, and a simple way to give through PayPal so the library can remain free.</p></div>
      </div>
      <div style="margin-top:2.5rem;display:flex;flex-wrap:wrap;gap:1rem">
        <a class="btn btn-wine" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn btn-gold" href={`mailto:${site.mentorshipEmail}`}>{site.mentorshipEmail}</a>
      </div>
    </div>
  </section>
</Base>
