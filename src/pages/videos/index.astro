---
import LessonGrid from "../../components/LessonGrid.astro";
import { featuredSeries } from "../../data/site";
import Base from "../../layouts/Base.astro";
---

<Base title="Videos" description="Watch Trust Hashem on YouTube and explore featured lesson series.">
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Watch</div>
      <h1>Videos</h1>
      <p class="lede">Play the Trust Hashem YouTube channel here, then continue into a featured series.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="video-embed-card">
        <h2>YouTube Channel</h2>
        <p>Subscribe for teachings of Emunah and Bitachon with Rebbetzin Leah Donner.</p>
        <div class="video-embed">
          <iframe
            src="https://www.youtube.com/embed/videoseries?list=UU6iM8W9BC1rYNg1I4fmsDlw"
            title="Trust Hashem YouTube channel"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <a class="btn btn-wine" href="https://www.youtube.com/@TrustHashem" rel="noopener noreferrer" target="_blank">
          Open YouTube Channel →
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-header">
        <span class="eyebrow">Continue</span>
        <h2>Featured Series</h2>
        <div class="divider"></div>
        <p class="lead">Open a series for the full audio lessons — play and download on-site.</p>
      </div>
      <LessonGrid lessons={featuredSeries as any} />
      <div style="margin-top:2.5rem">
        <a class="btn btn-wine" href="/library/">Browse all series →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .video-embed-card {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: clamp(1.1rem, 4vw, 2rem);
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }
  .video-embed-card h2 {
    margin-bottom: 0.5rem;
  }
  .video-embed-card p {
    margin-bottom: 1.5rem;
    color: var(--ink-soft);
  }
  .video-embed {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    margin-bottom: 1.5rem;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
  }
  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
