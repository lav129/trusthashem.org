---
import Base from "../../layouts/Base.astro";
import LessonGrid from "../../components/LessonGrid.astro";
import { featuredSeries } from "../../data/site";
import youtubeData from "../../data/youtube-videos.json";

const en = youtubeData.channels.en;
const es = youtubeData.channels.es;
const syncedLabel = new Date(youtubeData.syncedAt).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Base title="Videos" description="Watch Trust Hashem English and Spanish Bitachon lessons on YouTube.">
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Watch</div>
      <h1>Videos</h1>
      <p class="lede">
        English and Spanish lessons with Rebbetzin Leah Donner — synced from YouTube
        ({en.count} English · {es.count} Spanish · updated {syncedLabel}).
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="video-lang-tabs" role="tablist" aria-label="Lesson language">
        <button class="video-lang-tab is-active" type="button" role="tab" aria-selected="true" data-lang="en" id="tab-en">
          English <span>{en.count}</span>
        </button>
        <button class="video-lang-tab" type="button" role="tab" aria-selected="false" data-lang="es" id="tab-es">
          Spanish <span>{es.count}</span>
        </button>
      </div>

      <div class="video-lang-panel is-active" data-panel="en" role="tabpanel" aria-labelledby="tab-en">
        <div class="video-embed-card">
          <h2>{en.label}</h2>
          <p>Subscribe for teachings of Emunah and Bitachon — @{en.handle}</p>
          <div class="video-embed">
            <iframe
              src={en.embedPlaylist}
              title={en.label}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <a class="btn btn-wine" href={en.url} rel="noopener noreferrer" target="_blank">
            Open English Channel →
          </a>
        </div>

        <div class="video-grid-header">
          <h3>All English lessons</h3>
          <p>{en.count} videos synced from YouTube</p>
        </div>
        <div class="video-grid">
          {en.videos.map((video, i) => (
            <button
              class="video-card"
              type="button"
              data-embed={video.embed}
              data-title={video.title}
              data-lang="en"
            >
              <img src={video.thumb} alt="" loading={i < 8 ? "eager" : "lazy"} width="480" height="360" />
              <span class="video-card-title">{video.title === "Lesson" ? `Lesson ${i + 1}` : video.title}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="video-lang-panel" data-panel="es" role="tabpanel" aria-labelledby="tab-es" hidden>
        <div class="video-embed-card">
          <h2>{es.label}</h2>
          <p>Lecciones de Bitajón en español — @{es.handle}</p>
          <div class="video-embed">
            <iframe
              src={es.embedPlaylist}
              title={es.label}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <a class="btn btn-wine" href={es.url} rel="noopener noreferrer" target="_blank">
            Open Spanish Channel →
          </a>
        </div>

        <div class="video-grid-header">
          <h3>Todas las lecciones en español</h3>
          <p>{es.count} videos synced from YouTube</p>
        </div>
        <div class="video-grid">
          {es.videos.map((video, i) => (
            <button
              class="video-card"
              type="button"
              data-embed={video.embed}
              data-title={video.title}
              data-lang="es"
            >
              <img src={video.thumb} alt="" loading={i < 8 ? "eager" : "lazy"} width="480" height="360" />
              <span class="video-card-title">{video.title === "Lesson" ? `Lección ${i + 1}` : video.title}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-header">
        <span class="eyebrow">Continue</span>
        <h2>Featured Series</h2>
        <div class="divider"></div>
        <p class="lead">Open a series for the full audio lessons — play and download on-site.</p>
      </div>
      <LessonGrid lessons={featuredSeries as any} />
      <div style="margin-top:2.5rem">
        <a class="btn btn-wine" href="/library/">Browse all series →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .video-lang-tabs {
    display: inline-flex;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
    padding: 0.3rem;
    background: rgba(107, 36, 29, 0.06);
    border-radius: 999px;
  }
  .video-lang-tab {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .video-lang-tab span {
    display: inline-block;
    margin-left: 0.35rem;
    font-size: 0.78rem;
    opacity: 0.75;
  }
  .video-lang-tab.is-active {
    background: var(--wine);
    color: #fff;
  }
  .video-lang-panel[hidden] { display: none; }
  .video-embed-card {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: clamp(1.1rem, 4vw, 2rem);
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }
  .video-embed-card h2 { margin-bottom: 0.5rem; }
  .video-embed-card p {
    margin-bottom: 1.5rem;
    color: var(--ink-soft);
  }
  .video-embed {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    margin-bottom: 1.5rem;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
  }
  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-grid-header {
    margin: 2.5rem 0 1.25rem;
  }
  .video-grid-header h3 { margin-bottom: 0.35rem; }
  .video-grid-header p { color: var(--ink-soft); margin: 0; }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 1rem;
  }
  .video-card {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--paper);
    border-radius: 16px;
    overflow: hidden;
    padding: 0;
    text-align: left;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .video-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .video-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #111;
  }
  .video-card-title {
    display: block;
    padding: 0.75rem 0.85rem 0.95rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".video-lang-tab");
  const panels = document.querySelectorAll<HTMLElement>(".video-lang-panel");

  function activate(lang: string) {
    tabs.forEach((tab) => {
      const on = tab.dataset.lang === lang;
      tab.classList.toggle("is-active", on);
      tab.setAttribute("aria-selected", on ? "true" : "false");
    });
    panels.forEach((panel) => {
      const on = panel.dataset.panel === lang;
      panel.classList.toggle("is-active", on);
      panel.hidden = !on;
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => activate(tab.dataset.lang || "en"));
  });

  document.querySelectorAll<HTMLButtonElement>(".video-card").forEach((card) => {
    card.addEventListener("click", () => {
      const lang = card.dataset.lang || "en";
      const embed = card.dataset.embed;
      if (!embed) return;
      activate(lang);
      const panel = document.querySelector<HTMLElement>(`.video-lang-panel[data-panel="${lang}"]`);
      const iframe = panel?.querySelector<HTMLIFrameElement>(".video-embed iframe");
      if (iframe) {
        iframe.src = `${embed}?autoplay=1`;
        iframe.title = card.dataset.title || iframe.title;
      }
      panel?.querySelector(".video-embed-card")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
</script>
