---
import Base from "../layouts/Base.astro";
import LessonGrid from "../components/LessonGrid.astro";
import ShiurList from "../components/ShiurList.astro";
import TopicBrowse from "../components/TopicBrowse.astro";
import ExploreMore from "../components/ExploreMore.astro";
import {
  bitachonAttributes,
  homeIntro,
  homeTracks,
  featuredSeries,
  audioTopics,
  teacherBio,
  site,
  content,
} from "../data/site";
import { podcasts } from "../data/podcasts";

const featuredPodcasts = podcasts.slice(0, 6);
const popularTracks = homeTracks.slice(0, 5);
const HERO_WOMAN = "/images/hero/hero-woman.png?v=20260904h";
---

<Base title="Trust Hashem" description={homeIntro} image="/images/hero/hero-woman.png">

  <!-- ═══ HERO ═══════════════════════════════════════════════════════════ -->
  <section class="hero hero-with-cutout">
    <div class="hero-wash" aria-hidden="true"></div>
    <img class="hero-woman" src={HERO_WOMAN} alt="Rebbetzin Leah Donner" />
    <div class="hero-content">
      <div class="wrap hero-split">
        <div class="hero-copy">
          <div class="hero-eyebrow">Emunah & Bitachon · Geula, Jerusalem</div>
          <h1>Trust&nbsp;Hashem.<br/>Find Your Peace.</h1>
          <p class="hero-subtitle">{homeIntro}</p>
          <div class="hero-actions">
            <a class="btn btn-gold" href="/audio/">Explore Audio</a>
            <a class="btn btn-outline-dark" href="/library/">Browse Library</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ INTRO QUOTE ══════════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="pull-quote reveal">
        <blockquote>
          "Bitachon is not passive resignation — it is the active knowledge that Hashem is with you, guiding every detail of your life with infinite wisdom and love."
        </blockquote>
        <cite>— Shaar HaBitachon, Chovos HaLevavos</cite>
      </div>
    </div>
  </section>

  <!-- ═══ 7 ATTRIBUTES OF BITACHON ══════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="section-header">
        <span class="eyebrow">Foundation</span>
        <h2>The Seven Attributes of Bitachon</h2>
        <div class="divider"></div>
        <p class="lead">
          Chovos HaLevavos outlines seven foundational truths about Hashem that give a person complete trust and security.
        </p>
      </div>
      <div class="attributes-grid">
        {bitachonAttributes.map((attr) => (
          <div class="attr-item">
            <p>{attr}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PODCASTS ═════════════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-header">
        <span class="eyebrow">Everywhere you go</span>
        <h2>Podcasts</h2>
        <div class="divider"></div>
        <p class="lead">
          Classic sefarim, festivals, Bitachon, and women's learning groups — play every show on Trust Hashem.
        </p>
      </div>
      <div class="home-podcast-grid">
        {featuredPodcasts.map((show) => (
          <a class="home-podcast-card" href={`/podcasts/#${show.slug}`}>
            <img src={show.image || "/images/photo-books.jpg"} alt="" loading="lazy" />
            <div>
              {show.tag && <span class="card-tag">{show.tag}</span>}
              <h3>{show.title}</h3>
              <p>{show.blurb}</p>
              <span class="home-podcast-listen">Listen →</span>
            </div>
          </a>
        ))}
      </div>
      <ExploreMore href="/podcasts/" label="Explore More" />
    </div>
  </section>

  <!-- ═══ BROWSE BY TOPIC ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="section-header">
        <span class="eyebrow">Begin here</span>
        <h2>Browse by Topic</h2>
        <div class="divider"></div>
        <p class="lead">Choose the path that speaks to where you are now.</p>
      </div>
      <TopicBrowse topics={audioTopics.map(({ title, href, image }) => ({ title, href, image }))} />
      <ExploreMore href="/audio/" />
    </div>
  </section>

  <!-- ═══ FEATURED SERIES ══════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-header section-header-row">
        <div>
          <span class="eyebrow">Teachings</span>
          <h2>Featured Series</h2>
          <div class="divider"></div>
          <p class="lead">A few essential series to start with — not the whole library at once.</p>
        </div>
        <ExploreMore href="/library/" label="Explore More" align="end" />
      </div>
      <LessonGrid lessons={featuredSeries as any} />
    </div>
  </section>

  <!-- ═══ MENTORSHIP ═══════════════════════════════════════════════════ -->
  <section class="home-mentor">
    <div class="wrap home-mentor-grid">
      <figure class="home-mentor-emblem">
        <img src="/images/mentorship-you-within.jpg" alt="The YOU Within" width="480" height="480" />
      </figure>
      <div class="home-mentor-copy">
        <p class="home-mentor-pillars">Peace · Power · Purpose</p>
        <h2>Private Spiritual Mentorship</h2>
        <p class="home-mentor-lead">Stop performing. Start becoming.</p>
        <p>Tap into the power of the real YOU. Discover. Align. Become.</p>
        <div class="hero-actions" style="margin-top:1.75rem">
          <a class="btn btn-gold" href="/mentorship/">Enter Mentorship</a>
          <a class="btn btn-outline" href="mailto:Ask@LeahDonnerOfficial.com">Ask@LeahDonnerOfficial.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHO TEACHES ══════════════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="bio-block">
        <div>
          <img
            class="bio-img"
            src="/images/leah-donner-portrait.jpg?v=20260904c"
            alt="Rebbetzin Leah Donner"
          />
        </div>
        <div class="bio-text">
          <span class="eyebrow" style="color:var(--gold);letter-spacing:.14em;text-transform:uppercase;font-size:.75rem;font-weight:600;display:block;margin-bottom:.6rem">The Teacher</span>
          <h2>Rebbetzin Leah Donner</h2>
          <div class="divider" style="margin-bottom:1.5rem"></div>
          <p>{teacherBio}</p>
          <div class="bio-blessings">
            <span class="bio-blessing">HaGaon HaRav Yacov Moshe Hillel</span>
            <span class="bio-blessing">Rabbi Yonason David</span>
            <span class="bio-blessing">HaRav Itamar Schwartz</span>
          </div>
          <div style="margin-top:2rem">
            <a class="btn btn-gold" href="/who-we-are/">Learn more</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LISTEN ═══════════════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-header">
        <span class="eyebrow">Listen</span>
        <h2>Popular Lessons</h2>
        <div class="divider"></div>
        <p class="lead">A short start to Emunah & Bitachon — tap a title to play.</p>
      </div>
      <ShiurList tracks={popularTracks} moreHref="" moreLabel="" />
      <ExploreMore href="/audio/" />
    </div>
  </section>

  <!-- ═══ DONATE ════════════════════════════════════════════════════════ -->
  <section class="section section-gold">
    <div class="wrap">
      <div class="donate-home-grid">
        <div>
          <span style="font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--gold-light);display:block;margin-bottom:.75rem">Support This Work</span>
          <h2 style="color:#fff;font-size:clamp(1.8rem,3.5vw,2.8rem);margin-bottom:1rem">Help Spread the Light of Torah</h2>
          <p style="color:rgba(255,255,255,.8);font-size:1.05rem;margin-bottom:2rem">
            Your contribution — of any size — keeps these teachings free and accessible to Jewish people everywhere. Every donation creates a ripple of learning, faith, and connection to Hashem.
          </p>
          <a class="btn btn-gold" href="/donate/">Donate Now</a>
        </div>
        <div class="donate-home-panel">
          <p style="color:rgba(255,255,255,.7);font-size:1rem;margin-bottom:1.5rem;font-style:italic">"One mitzvah leads to another, building a world of kindness and light."</p>
          <form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_blank">
            <input type="hidden" name="cmd" value="_s-xclick" />
            <input type="hidden" name="hosted_button_id" value={content.paypalButtonId} />
            <input type="hidden" name="currency_code" value="USD" />
            <button type="submit" class="btn btn-gold" style="width:100%;justify-content:center">
              Donate via PayPal
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHATSAPP / DAILY LESSON ════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="whatsapp-banner">
        <div class="whatsapp-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="42" height="42" fill="currentColor"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.96L0 24l6.3-1.65a11.86 11.86 0 0 0 5.76 1.47h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.45-8.44zM12.07 21.15h-.01a9.86 9.86 0 0 1-5.02-1.37l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.24c0-5.45 4.43-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.98c0 5.45-4.44 9.88-9.89 9.88zm5.43-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35z"/></svg>
        </div>
        <div>
          <h3>Receive a Daily Lesson on WhatsApp</h3>
          <p>A short, inspiring Torah thought — delivered to your phone every day. Free and easy to join.</p>
          <a class="btn btn-gold btn-sm" href={site.homeWhatsapp} rel="noopener noreferrer" target="_blank">
            Join the WhatsApp Group
          </a>
          <p style="font-size:.8rem;opacity:.7;margin-top:.75rem;margin-bottom:0">
            If the group is full, email <a href={`mailto:${site.email}`} style="color:var(--gold-light)">{site.email}</a> to join a new group.
          </p>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  .donate-home-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .donate-home-panel {
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 24px;
    padding: 2.5rem;
  }
  .home-podcast-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .home-podcast-card {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 0.95rem;
    align-items: start;
    padding: 0.95rem;
    border-radius: 18px;
    background: var(--paper);
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform .2s, box-shadow .2s, border-color .2s;
    min-width: 0;
  }
  .home-podcast-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-gold);
  }
  .home-podcast-card img {
    width: 88px;
    height: 88px;
    border-radius: 14px;
    object-fit: cover;
    object-position: center;
  }
  .home-podcast-card h3 {
    font-size: 0.98rem;
    line-height: 1.3;
    margin: 0.2rem 0 0.35rem;
    overflow-wrap: anywhere;
  }
  .home-podcast-card p {
    font-size: 0.82rem;
    color: var(--ink-muted);
    margin: 0;
  }
  .home-podcast-listen {
    display: inline-block;
    margin-top: 0.45rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #3a6ea5;
  }
  .section-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .section-header-row .explore-more { margin-top: 0.35rem; }
  @media (max-width: 700px) {
    .section-header-row { flex-direction: column; gap: 0.5rem; }
  }
  .home-mentor {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    background:
      radial-gradient(ellipse at 80% 20%, rgba(212,175,55,0.16), transparent 45%),
      linear-gradient(155deg, #0c1a12 0%, #163024 55%, #1b3022 100%);
    color: #f7f1e4;
  }
  .home-mentor-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .home-mentor-emblem {
    margin: 0;
    text-align: center;
  }
  .home-mentor-emblem img {
    width: min(100%, 360px);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    object-position: center;
    margin-inline: auto;
    border-radius: 50%;
    border: 2px solid rgba(212,175,55,0.5);
    box-shadow: 0 24px 60px rgba(0,0,0,0.35);
    background: #13261c;
  }
  .home-mentor-pillars {
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: #d4af37;
    font-weight: 700;
    margin-bottom: 0.85rem;
  }
  .home-mentor-copy h2 {
    color: #fff;
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    margin-bottom: 0.75rem;
  }
  .home-mentor-lead {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.35rem;
    color: #f0e2c0;
    margin-bottom: 0.65rem;
  }
  .home-mentor-copy p { color: rgba(247,241,228,0.78); max-width: 40rem; }

  @media (max-width: 980px) {
    .home-podcast-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 700px) {
    .donate-home-grid { grid-template-columns: 1fr; gap: 2rem; }
    .home-podcast-grid { grid-template-columns: 1fr; }
    .home-mentor-grid { grid-template-columns: 1fr; }
    .home-mentor-emblem img { width: min(100%, 280px); }
  }
</style>
