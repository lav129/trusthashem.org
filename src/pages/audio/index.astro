---
import AudioList from "../../components/AudioList.astro";
import LessonGrid from "../../components/LessonGrid.astro";
import { homeTracks, lessons } from "../../data/site";
import Base from "../../layouts/Base.astro";
---

<Base title="Audio" description="Audio lessons from Trust Hashem, taught by Rebbetzin Leah Donner.">
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Listen</div>
      <h1>Audio</h1>
      <p class="lede">Start with the homepage series, then open any series in the library.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-header">
        <span class="eyebrow">Start here</span>
        <h2>Introduction to Emunah & Bitachon</h2>
        <div class="divider"></div>
        <p class="lead">A short set of foundational lessons — play or download each track.</p>
      </div>
      <AudioList tracks={homeTracks.slice(0, 8)} />
      <div style="margin:2rem 0 2.5rem">
        <a class="btn btn-wine" href="/library/">Browse every series →</a>
      </div>
      <div class="section-header">
        <span class="eyebrow">Series</span>
        <h2>Continue by topic</h2>
        <div class="divider"></div>
      </div>
      <LessonGrid lessons={lessons} />
    </div>
  </section>
</Base>
