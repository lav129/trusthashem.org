---
import { site } from "../../data/site";
import Base from "../../layouts/Base.astro";
---

<Base title="Privacy Policy" description="How to reach Trust Hashem about privacy.">
  <section class="page-hero">
    <div class="wrap">
      <h1>Privacy Policy</h1>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <p>Questions about privacy for TrustHashem.org can be sent to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <p>Donations are processed by PayPal. WhatsApp groups are hosted by WhatsApp.</p>
    </div>
  </section>
</Base>
