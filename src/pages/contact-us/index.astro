---
import { site } from "../../data/site";
import Base from "../../layouts/Base.astro";
---

<Base title="Contact Us" description="Write to Trust Hashem at bitachon@trusthashem.org.">
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Reach us</div>
      <h1>Contact Us</h1>
      <p class="lede">For WhatsApp groups and questions about the lessons, write to {site.email}.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <label>Name <input name="name" required /></label>
        <label>Email <input type="email" name="email" required /></label>
        <label>Subject <input name="subject" required /></label>
        <label>Message <textarea name="message" rows="8"></textarea></label>
        <button class="btn btn-wine" type="submit">Send by email</button>
      </form>
      <p>
        Or email directly: <a href={`mailto:${site.email}`}>{site.email}</a><br />
        WhatsApp: <a href={site.homeWhatsapp} rel="noopener noreferrer">join the group</a>
      </p>
    </div>
  </section>
</Base>
